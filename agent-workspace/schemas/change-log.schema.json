{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kongoni.example/schemas/change-log.schema.json",
  "title": "KongoniApp Change Log Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "timestamp_utc",
    "actor",
    "mandate_ref",
    "task_class",
    "change_type",
    "summary",
    "reason",
    "affected_paths",
    "environment",
    "authority",
    "pdca",
    "evidence"
  ],
  "properties": {
    "change_id": {"type": "string", "pattern": "^CHG-[0-9]{8}-[A-Z0-9-]+$"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {"enum": ["human", "ChatGPT", "Claude", "Codex", "Zia", "specialist_agent", "automation"]},
        "name": {"type": "string", "minLength": 1},
        "agent_contract_ref": {"type": ["string", "null"]}
      }
    },
    "mandate_ref": {"type": "string", "minLength": 1},
    "accountability_task_ref": {"type": ["string", "null"]},
    "task_class": {"enum": ["T0", "T1", "T2", "T3"]},
    "change_type": {"enum": ["source_code", "configuration", "schema", "workflow", "infrastructure", "integration", "governance", "agent_contract", "prompt_or_instruction", "deployment"]},
    "summary": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "affected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment": {"enum": ["repository", "development", "sandbox", "staging", "production"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": {"enum": ["AUTHORISED", "NOT_REQUIRED", "PENDING"]},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "pdca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "do_complete", "task_complete"],
      "properties": {
        "phase": {"enum": ["MANDATE", "PLAN", "AUTHORISATION", "DO", "EVIDENCE", "CHECK_STUDY", "ACT", "RECORD", "CLOSE_OR_REPLAN"]},
        "do_complete": {"type": "boolean"},
        "check_study_result": {"type": ["string", "null"]},
        "act_decision": {"type": ["string", "null"], "enum": ["ADOPT", "ADAPT", "REPEAT", "REJECT", "ESCALATE", null]},
        "task_complete": {"type": "boolean"}
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "commit_sha": {"type": ["string", "null"]},
    "pull_request": {"type": ["integer", "null"], "minimum": 1},
    "notes": {"type": ["string", "null"]}
  }
}
