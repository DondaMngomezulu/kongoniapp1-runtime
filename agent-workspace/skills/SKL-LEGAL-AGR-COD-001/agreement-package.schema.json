{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kongoni:schema:agreement-machine-readable-package:1.0",
  "title": "Agreement Machine-Readable Package Manifest",
  "type": "object",
  "required": ["package_id", "agreement_id", "package_status", "skill", "source", "outputs", "validation", "provenance"],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "agreement_id": {"type": "string", "minLength": 1},
    "agreement_type": {"type": ["string", "null"]},
    "package_status": {
      "type": "string",
      "enum": ["DRAFT", "EXCEPTION", "LEGAL_REVIEW_REQUIRED", "VALIDATED", "SUPERSEDED"]
    },
    "skill": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "SKL-LEGAL-AGR-COD-001"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["artifact_id", "sha256", "authority_status"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "filename": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "authority_status": {"enum": ["authoritative", "working_copy", "unknown"]},
        "execution_status": {"enum": ["draft", "executed", "amended", "terminated", "expired", "superseded", "unknown"]}
      },
      "additionalProperties": true
    },
    "agreement": {
      "type": "object",
      "properties": {
        "title": {"type": ["string", "null"]},
        "execution_date": {"type": ["string", "null"], "format": "date"},
        "effective_date": {"type": ["string", "null"], "format": "date"},
        "governing_law": {"type": ["string", "null"]},
        "parties": {"type": "array", "items": {"type": "object"}},
        "related_agreements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["legal_document", "legal_rules", "semantic_projection", "provenance"],
      "properties": {
        "legal_document": {"$ref": "#/$defs/outputArtifact"},
        "legal_rules": {"$ref": "#/$defs/outputArtifact"},
        "semantic_projection": {"$ref": "#/$defs/outputArtifact"},
        "provenance": {"$ref": "#/$defs/outputArtifact"}
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["p0_open", "p1_open", "overall_status"],
      "properties": {
        "p0_open": {"type": "integer", "minimum": 0},
        "p1_open": {"type": "integer", "minimum": 0},
        "exceptions": {"type": "array", "items": {"type": "object"}},
        "overall_status": {"enum": ["NOT_RUN", "PASSED", "FAILED", "PASSED_WITH_EXCEPTIONS"]}
      },
      "additionalProperties": true
    },
    "legal_review": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "reviewer_role": {"type": ["string", "null"]},
        "status": {"enum": ["NOT_STARTED", "IN_REVIEW", "APPROVED", "REJECTED", "NOT_REQUIRED"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "properties": {
        "operative_use_allowed": {"type": "boolean"},
        "published_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["codified_at", "codified_by", "methodology", "standards"],
      "properties": {
        "codified_at": {"type": "string", "format": "date-time"},
        "codified_by": {"type": "string", "minLength": 1},
        "methodology": {"const": "MET-PDCA-001"},
        "standards": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "outputArtifact": {
      "type": "object",
      "required": ["format", "path", "validation_status"],
      "properties": {
        "format": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["NOT_RUN", "PASSED", "FAILED", "PASSED_WITH_EXCEPTIONS"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
