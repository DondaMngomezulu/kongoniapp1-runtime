{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contextual template catalogue snapshot - engineering candidate",
  "description": "Controlled metadata projection only; publication authority is external and must be independently verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_ref",
    "snapshot_sha256",
    "source_register_ref",
    "templates"
  ],
  "properties": {
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_register_ref": {
      "type": "string",
      "minLength": 1
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "version",
        "sha256",
        "approval_ref",
        "status",
        "issuer_entity",
        "value_stream",
        "intents",
        "document_classes",
        "channels",
        "required_fields"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approval_ref": {
          "type": "string"
        },
        "status": {
          "enum": [
            "CONTROLLED",
            "DRAFT",
            "HOLD",
            "RETIRED"
          ]
        },
        "issuer_entity": {
          "type": "string",
          "minLength": 1
        },
        "value_stream": {
          "type": "string",
          "pattern": "^VS[0-9]{2}$"
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "document_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          }
        },
        "allowed_stages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "allowed_contract_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "allowed_locales": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "preferred_audiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/code"
          }
        }
      }
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+.-]{1,80}$"
    }
  }
}