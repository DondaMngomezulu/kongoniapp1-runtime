{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI native customer correspondence release request candidate, review only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "action",
    "channel",
    "crm",
    "issuer",
    "template",
    "parent",
    "snapshot",
    "approval",
    "recipients",
    "transport"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "ISSUE",
        "SEND",
        "SIGN",
        "PUBLISH_EXTERNALLY"
      ]
    },
    "channel": {
      "enum": [
        "CH-EMAIL",
        "CH-WHATSAPP",
        "CH-WECHAT",
        "CH-VOICE",
        "CH-WEBFORM",
        "CH-OTHER"
      ]
    },
    "crm": {
      "type": "object",
      "required": [
        "module",
        "record_id",
        "account_id"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        }
      }
    },
    "issuer": {
      "type": "object",
      "required": [
        "entity_id",
        "sender_id"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "sender_id": {
          "type": "string"
        }
      }
    },
    "template": {
      "$ref": "#/$defs/template"
    },
    "parent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/template"
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "required": [
        "source_hash",
        "artifact_hash",
        "merge_status"
      ],
      "properties": {
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "merge_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_TESTED"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "receipt",
        "approver",
        "status",
        "source_hash",
        "artifact_hash",
        "expires_at"
      ],
      "properties": {
        "receipt": {
          "type": "string"
        },
        "approver": {
          "type": "string"
        },
        "status": {
          "enum": [
            "APPROVED",
            "PENDING",
            "REJECTED"
          ]
        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "adapter_id",
        "idempotency_key"
      ],
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "version",
        "hash",
        "class",
        "status",
        "approval_receipt",
        "issuer_id",
        "channels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "class": {
          "type": "string"
        },
        "status": {
          "enum": [
            "CONTROLLED",
            "HOLD",
            "DRAFT",
            "RETIRED"
          ]
        },
        "approval_receipt": {
          "type": "string"
        },
        "issuer_id": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
