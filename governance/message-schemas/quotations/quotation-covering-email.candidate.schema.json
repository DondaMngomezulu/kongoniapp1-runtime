{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quotation covering email composition candidate; review only",
  "description": "Stage-aware structured inputs, not a published enterprise or runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle_mode",
    "source_record",
    "template",
    "sections",
    "approval_status"
  ],
  "properties": {
    "lifecycle_mode": {
      "enum": [
        "prequote",
        "issued_quotation"
      ]
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "id"
      ],
      "properties": {
        "module": {
          "enum": [
            "Leads",
            "Deals",
            "Quotes"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "version",
        "merge_schema_id",
        "published"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "merge_schema_id": {
          "const": "MRG-CVR-001"
        },
        "published": {
          "type": "boolean"
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "assumptions",
        "technical_offer",
        "finance_offer",
        "commercial_offer",
        "clarifications"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "technical_offer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "finance_offer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "commercial_offer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "clarifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence_status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "verified",
                  "proposed",
                  "clarification_required"
                ]
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "approval_status": {
      "enum": [
        "review_only",
        "approved_for_send"
      ]
    },
    "parent_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "document_id",
        "approved",
        "rendered"
      ],
      "properties": {
        "template_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "approved": {
          "type": "boolean"
        },
        "rendered": {
          "type": "boolean"
        }
      }
    },
    "quote_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "account_can_issue_quotes",
        "quote_approved",
        "prices_approved",
        "issuer_verified"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "account_can_issue_quotes": {
          "type": "boolean"
        },
        "quote_approved": {
          "type": "boolean"
        },
        "prices_approved": {
          "type": "boolean"
        },
        "issuer_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_mode": {
            "const": "prequote"
          }
        },
        "required": [
          "lifecycle_mode"
        ]
      },
      "then": {
        "properties": {
          "source_record": {
            "properties": {
              "module": {
                "enum": [
                  "Leads",
                  "Deals"
                ]
              }
            }
          },
          "approval_status": {
            "const": "review_only"
          }
        },
        "not": {
          "required": [
            "quote_release"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_mode": {
            "const": "issued_quotation"
          }
        },
        "required": [
          "lifecycle_mode"
        ]
      },
      "then": {
        "required": [
          "quote_release",
          "parent_document"
        ],
        "properties": {
          "source_record": {
            "properties": {
              "module": {
                "const": "Quotes"
              }
            }
          },
          "template": {
            "properties": {
              "published": {
                "const": true
              }
            }
          },
          "parent_document": {
            "properties": {
              "approved": {
                "const": true
              },
              "rendered": {
                "const": true
              }
            }
          },
          "quote_release": {
            "properties": {
              "account_can_issue_quotes": {
                "const": true
              },
              "quote_approved": {
                "const": true
              },
              "prices_approved": {
                "const": true
              },
              "issuer_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
