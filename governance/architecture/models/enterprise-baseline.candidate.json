  "value_streams": [
    {
      "id": "VS00",
      "name": "Enterprise Shared Content & Capabilities",
      "definition": "Enterprise-wide shared semantic, governance, reference, platform and enabling content/capabilities that are reused across VS01–VS05 and are not exclusively owned by any operating Value Stream.",
      "source_status": "APPROVED ENTERPRISE SHARED LOCUS",
      "stage_status": "NOT AN OPERATING VALUE STREAM — NO VALUE-STAGE MODEL REQUIRED",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS01",
      "name": "Asset Provision & Access",
      "definition": "Transform a validated requirement for productive-asset access into an agreed, provisioned and accepted asset-access arrangement, while originating and orchestrating associated lease and insurance requirements for specialist execution by VS02 and VS03.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "ADOPTED TOGAF-ANCHORED STAGE MODEL",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS02",
      "name": "Asset Finance & Capital Provision",
      "definition": "Transform a validated lease or financing requirement handed over from VS01 into an assessed, structured, approved, funded and serviced financing exposure that is ultimately settled, refinanced, transferred or distributed.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "ADOPTED TOGAF-ANCHORED STAGE MODEL",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS03",
      "name": "Asset Risk Protection & Recovery",
      "definition": "Transform a validated insurance/protection requirement handed over from VS01 into effective protection and, where a covered loss occurs, into an administered and settled recovery outcome.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "ADOPTED TOGAF-ANCHORED STAGE MODEL",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS04",
      "name": "Asset Lifecycle Performance",
      "definition": "Transform lifecycle/service demand originated by ServiceCo under an active Master Service Agreement into sustained and optimised productive-asset performance through condition monitoring, maintenance, reliability intervention and authorised lifecycle exit.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "ADOPTED TOGAF-ANCHORED STAGE MODEL",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS05",
      "name": "Investment & Portfolio Value Realisation",
      "definition": "Transform an investment thesis, strategic opportunity or capital-allocation requirement into an evaluated, approved, executed and governed investment position or strategic transaction, including senior-debt investment into FinanceCo, that produces authorised value realisation.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "ADOPTED TOGAF-ANCHORED STAGE MODEL",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    },
    {
      "id": "VS06",
      "name": "Mining Production & Delivery",
      "definition": "Creates stakeholder value by converting approved mining contract requirements and mine production plans into delivered mining production that meets agreed quantity, quality, schedule, safety and commercial performance requirements. The value stream covers the end-to-end flow of production delivery and excludes mine asset lifecycle support, maintenance, reliability, spares, tyres, GET, fuel support and related equipment-life-support activities, which remain governed within VS04 Asset Lifecycle Performance.",
      "source_status": "ADOPTED VALUE STREAM",
      "stage_status": "DRAFT STAGE MODEL — PENDING ADOPTION",
      "technical_state": "EXISTING_ARCHITECTURE_CONCEPT_NOT_PHYSICAL_SERVICE"
    }
  ],
