{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kongoni.group/schemas/CEOApprovalEvidence.schema.json",
  "title": "CEO Approval Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_or_template_id",
    "object_or_template_version",
    "object_class",
    "decision",
    "approver_role",
    "approver_identity",
    "approval_timestamp",
    "approval_source_reference",
    "pdca_cycle_reference",
    "evidence_reference"
  ],
  "properties": {
    "object_or_template_id": {"type": "string", "minLength": 1},
    "object_or_template_version": {"type": "string", "minLength": 1},
    "object_class": {
      "type": "string",
      "enum": ["MESSAGE_TEMPLATE", "BUSINESS_OBJECT", "CATALOGUE", "REGISTER", "SCHEMA", "PORTAL_OBJECT", "OTHER_GOVERNED_OBJECT"]
    },
    "decision": {
      "type": "string",
      "enum": ["ADOPT", "ADAPT", "REPEAT", "REJECT", "ESCALATE"]
    },
    "approver_role": {"const": "Group CEO"},
    "approver_identity": {"const": "Donda Khumalo"},
    "approval_timestamp": {"type": "string", "format": "date-time"},
    "approval_source_reference": {"type": "string", "minLength": 1},
    "pdca_cycle_reference": {"type": "string", "minLength": 1},
    "evidence_reference": {"type": "string", "minLength": 1}
  }
}
