{
  "id": "BR-COMM-WA-QUOTATION-001",
  "version": "0.1.0",
  "state": "REVIEW_ONLY",
  "production_send": false,
  "authority": {
    "business_document": "STD-BDOC-001",
    "channel": "STD-TMF-OC-001",
    "crm_information": "STD-TMF-SID-001",
