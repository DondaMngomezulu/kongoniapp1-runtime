{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity verification evidence envelope (candidate, Issue 76)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "contact_id", "document_type", "status", "provider", "checks", "observed_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "contact_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "document_type": {"enum": ["SA_ID", "DRIVERS_LICENCE"]},
    "status": {"enum": ["PENDING", "REJECTED", "MANUAL_REVIEW_REQUIRED", "VERIFIED"]},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "reference", "authenticated", "verification_method"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "authenticated": {"type": "boolean"},
        "verification_method": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": {"type": "boolean"},
      "required": ["document_authenticity", "authoritative_match", "crm_match"]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "consent_reference": {"type": ["string", "null"]},
    "document_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "maxLength": 256}
  }
}
